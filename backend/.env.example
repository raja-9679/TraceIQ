# Backend environment template — copy to backend/.env and fill in real values.
# Do NOT commit the filled-in .env (it is now gitignored).

# Postgres (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/traceiq

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO object storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me

# JWT signing — MUST be a strong random value in production. Rotating this
# invalidates all sessions AND all stored project secrets (see core/secrets.py).
SECRET_KEY=change-me-to-a-long-random-string

# Dedicated shared secret for worker->backend webhook/finalize calls.
# Falls back to SECRET_KEY if unset.
WEBHOOK_SECRET=

# LLM provider (optional). Set ANTHROPIC_API_KEY for Claude-backed failure
# analysis / self-heal, or OPENAI_API_KEY. LLM_PROVIDER can force one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-4-8

# CORS: comma-separated exact origins in production. Do NOT use ["*"] with
# credentials enabled.
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Worker feature flags
# ALLOW_PYTHON_SCRIPTS=false   # enable run-script python (RCE in worker; trusted authors only)
# PROACTIVE_HEAL_ENABLED=false
# AI_ANALYSIS_ENABLED=false
