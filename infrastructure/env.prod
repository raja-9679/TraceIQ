# General
OPENAI_API_KEY=your-key-here

# Backend
# CRITICAL: Use a strong, unique secret key for production
SECRET_KEY=***REMOVED-BY-HISTORY-REWRITE***
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=["https://app.traceiq.example.com"]

# Frontend
# Points to the PROD environment API
VITE_API_BASE_URL=https://api.traceiq.example.com/api

# Execution Engine
ARTIFACTS_DIR=/tmp/artifacts
DEFAULT_TIMEOUT=60000

# Infrastructure
MINIO_ROOT_USER=***REMOVED-BY-HISTORY-REWRITE***
MINIO_ROOT_PASSWORD=***REMOVED-BY-HISTORY-REWRITE***
POSTGRES_USER=***REMOVED-BY-HISTORY-REWRITE***
POSTGRES_PASSWORD=***REMOVED-BY-HISTORY-REWRITE***
