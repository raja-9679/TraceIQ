# General
OPENAI_API_KEY=your-key-here

# Backend
# Use a secure secret key for production!
SECRET_KEY=***REMOVED-BY-HISTORY-REWRITE***
ALGORITHM=HS256

# Infrastructure (Postgres/MinIO)
# These should be changed to secure, randomly generated passwords
POSTGRES_USER=user
POSTGRES_PASSWORD=***REMOVED-BY-HISTORY-REWRITE***
POSTGRES_DB=quality_intelligence

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=***REMOVED-BY-HISTORY-REWRITE***
MINIO_PUBLIC_URL=https://traceiqstore.thehindu.co.in

# Frontend
# Public URL for the frontend API routing, typically the domain name or Load Balancer IP
API_PUBLIC_URL=https://traceiq.thehindu.co.in/api

# Execution Engine
WORKER_REPLICAS=3

# Notification Settings
# Master switch - if false, no notifications sent
NOTIFICATIONS_ENABLED=false
# Individual channel controls (only used if NOTIFICATIONS_ENABLED=true)
EMAIL_NOTIFICATIONS_ENABLED=false
SLACK_NOTIFICATIONS_ENABLED=false
TEAMS_NOTIFICATIONS_ENABLED=false
# Only notify on failures (skip passed runs)
NOTIFY_ON_FAILURE_ONLY=false

# Email (SMTP) Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@traceiq.io

# Slack Webhook URL
SLACK_WEBHOOK_URL=

# Microsoft Teams Webhook URL
TEAMS_WEBHOOK_URL=
