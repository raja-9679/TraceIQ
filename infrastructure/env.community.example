# TraceIQ self-hosted — environment template
#
# Copy to .env and fill in, or run ./traceiq-setup.sh to generate the secrets
# for you:
#
#   cp env.community.example .env
#   docker compose -f docker-compose.community.yml --env-file .env up -d
#
# There are no default values for the secrets below, on purpose. A default
# baked into a distributed image is the same secret on every deployment — for
# SECRET_KEY that means anyone could mint a valid login token against your
# instance. Compose will refuse to start until these are set.

# ---------------------------------------------------------------------------
# Required secrets — generate each one separately
#   openssl rand -hex 32
# ---------------------------------------------------------------------------

# Signs login/session JWTs.
SECRET_KEY=

# Authenticates execution workers calling back into the API. Keep this DIFFERENT
# from SECRET_KEY so either can be rotated without invalidating the other.
WEBHOOK_SECRET=

# Database and object/queue storage credentials.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=traceiq
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Where your instance is reachable
# ---------------------------------------------------------------------------

# Host ports. Change if these collide with something already running.
FRONTEND_PORT=8080
BACKEND_PORT=8000
MINIO_PORT=9000

# The browser downloads test artifacts (traces, videos, screenshots) straight
# from MinIO using presigned URLs, so this must be the address a BROWSER can
# reach — not an internal Docker hostname. If you serve TraceIQ to other
# machines, set it to that host or domain.
MINIO_PUBLIC_URL=http://localhost:9000

# Must include every origin the UI is served from, as a JSON list. A bare "*"
# is rejected in production.
BACKEND_CORS_ORIGINS=["http://localhost:8080"]
FRONTEND_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Outbound fetch policy — read before changing
# ---------------------------------------------------------------------------

# TraceIQ fetches URLs that users supply (the app under test, OpenAPI schemas,
# outbound webhooks). By default it refuses targets that resolve to private or
# loopback addresses, which blocks the classic SSRF where a user aims a test at
# your internal services.
#
# Most self-hosters DO need to test internal apps, so you will probably set this
# true. Understand the tradeoff: true means any user of this instance can make
# the server fetch any address your server can reach. That is fine on a trusted
# single-team deployment and NOT fine if you let untrusted people sign up.
#
# Cloud instance-metadata addresses (169.254.169.254) stay blocked either way.
ALLOW_PRIVATE_NETWORK_TARGETS=false

# Narrower alternative to the flag above: permit only specific hosts, as a JSON
# list. Prefer this if you only need one or two internal targets.
# OUTBOUND_ALLOWED_HOSTS=["staging.internal","host.docker.internal"]

# ---------------------------------------------------------------------------
# Capacity and retention
# ---------------------------------------------------------------------------

# Parallel browser workers. Each needs roughly 1 CPU and 1.5 GB RAM under load.
EXECUTION_WORKERS=2
CELERY_CONCURRENCY=4

# Finished runs and their artifacts are deleted after this many days.
# 0 disables cleanup entirely and your disk will grow without bound — traces and
# videos are large. 90 days is a reasonable starting point.
RUN_RETENTION_DAYS=90

# Pin a release instead of tracking latest, so upgrades are deliberate.
TRACEIQ_VERSION=latest

# ---------------------------------------------------------------------------
# Optional — AI failure analysis
# ---------------------------------------------------------------------------
# Leave LLM_PROVIDER empty to disable AI features entirely; TraceIQ falls back
# to heuristic failure summaries and everything else works normally.
# Supported: anthropic | openai | gemini | ollama | openai-compatible
LLM_PROVIDER=
LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# For a self-hosted model, no API key leaves your network:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder:14b
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------------------
# Optional — notifications
# ---------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=traceiq@yourcompany.com
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Advanced — leave alone unless you know you need them
# ---------------------------------------------------------------------------
# Retries a failing step with an LLM-suggested selector. Needs an LLM provider.
RUNTIME_HEAL_ENABLED=false

# Runs user-uploaded Playwright specs verbatim. This is arbitrary code execution
# inside the worker container. Only enable on an instance where you trust every
# user, and never on one exposed to the internet.
RAW_PLAYWRIGHT_ENABLED=false
