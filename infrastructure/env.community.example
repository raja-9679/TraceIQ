# TraceIQ self-hosted — environment template
#
# Copy to .env and fill in, or run ./traceiq-setup.sh to generate the secrets
# for you:
#
#   cp env.community.example .env
#   docker compose -f docker-compose.community.yml --env-file .env up -d
#
# There are no default values for the secrets below, on purpose. A default
# baked into a distributed image is the same secret on every deployment — for
# SECRET_KEY that means anyone could mint a valid login token against your
# instance. Compose will refuse to start until these are set.

# ---------------------------------------------------------------------------
# Required secrets — generate each one separately
#   openssl rand -hex 32
#
# traceiq-setup.sh fills these in for you, and respects any value already set
# in your environment when it runs (POSTGRES_PASSWORD=... ./traceiq-setup.sh),
# so you can bring your own instead of editing this file afterwards.
# ---------------------------------------------------------------------------

# Signs login/session JWTs.
SECRET_KEY=

# Authenticates execution workers calling back into the API. Keep this DIFFERENT
# from SECRET_KEY so either can be rotated without invalidating the other.
WEBHOOK_SECRET=

# Database and object/queue storage credentials.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=traceiq
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Where your instance is reachable
# ---------------------------------------------------------------------------

# Host ports. Change if these collide with something already running.
FRONTEND_PORT=8080
BACKEND_PORT=8000
MINIO_PORT=9000

# The browser downloads test artifacts (traces, videos, screenshots) straight
# from MinIO using presigned URLs, so this must be the address a BROWSER can
# reach — not an internal Docker hostname. If you serve TraceIQ to other
# machines, set it to that host or domain.
MINIO_PUBLIC_URL=http://localhost:9000

# Must include every origin the UI is served from, as a JSON list. A bare "*"
# is rejected in production.
BACKEND_CORS_ORIGINS=["http://localhost:8080"]
FRONTEND_BASE_URL=http://localhost:8080

# Split deployment only: where the frontend's nginx proxies /api/ to. Leave
# commented when the backend runs in this compose stack (the default reaches
# it by service name).
# FRONTEND_PROXY_BACKEND_URL=http://backend.internal.example.com:8000

# ---------------------------------------------------------------------------
# Outbound fetch policy — read before changing
# ---------------------------------------------------------------------------

# TraceIQ fetches URLs that users supply (the app under test, OpenAPI schemas,
# outbound webhooks). By default it refuses targets that resolve to private or
# loopback addresses, which blocks the classic SSRF where a user aims a test at
# your internal services.
#
# Most self-hosters DO need to test internal apps, so you will probably set this
# true. Understand the tradeoff: true means any user of this instance can make
# the server fetch any address your server can reach. That is fine on a trusted
# single-team deployment and NOT fine if you let untrusted people sign up.
#
# Cloud instance-metadata addresses (169.254.169.254) stay blocked either way.
ALLOW_PRIVATE_NETWORK_TARGETS=false

# Narrower alternative to the flag above: permit only specific hosts, as a JSON
# list. Prefer this if you only need one or two internal targets.
# OUTBOUND_ALLOWED_HOSTS=["staging.internal","host.docker.internal"]

# ---------------------------------------------------------------------------
# Capacity and retention
# ---------------------------------------------------------------------------

# Parallel browser workers. Each needs roughly 1 CPU and 1.5 GB RAM under load.
EXECUTION_WORKERS=2
CELERY_CONCURRENCY=4

# Finished runs and their artifacts are deleted after this many days.
# 0 disables cleanup entirely and your disk will grow without bound — traces and
# videos are large. 90 days is a reasonable starting point.
RUN_RETENTION_DAYS=90

# Pin a release instead of tracking latest, so upgrades are deliberate.
TRACEIQ_VERSION=latest

# Where images are pulled from. GHCR is the default; the same images are
# mirrored to Docker Hub — uncomment to pull from there instead (useful when
# ghcr.io is blocked or rate-limited on your network).
# TODO(release): replace with the real Docker Hub namespace before publishing.
# TRACEIQ_REGISTRY=docker.io/<dockerhub-namespace>

# ---------------------------------------------------------------------------
# Optional — AI failure analysis
# ---------------------------------------------------------------------------
# Leave LLM_PROVIDER empty to disable AI features entirely; TraceIQ falls back
# to heuristic failure summaries and everything else works normally.
# Supported: anthropic | openai | gemini | ollama | openai-compatible
LLM_PROVIDER=
LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# For a self-hosted model, no API key leaves your network:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder:14b
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------------------
# Optional — mobile app testing (Android via Appium)
# ---------------------------------------------------------------------------
# Start the mobile services with the `mobile` profile:
#   docker compose -f docker-compose.community.yml --env-file .env --profile mobile up -d
# The bundled Android emulator REQUIRES /dev/kvm on the host. Watch the device
# screen at http://localhost:6080. Without KVM (or for iOS), set a device
# cloud provider instead: browserstack | saucelabs | lambdatest, plus its
# credentials below — the local emulator/appium services then sit idle.
# MOBILE_DEVICE_PROVIDER=local
# MOBILE_EMULATOR_DEVICE=Samsung Galaxy S10
# MOBILE_VNC_PORT=6080
# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=
# SAUCE_USERNAME=
# SAUCE_ACCESS_KEY=
# LT_USERNAME=
# LT_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Optional — bootstrap admin account
# ---------------------------------------------------------------------------
# Created at first backend start ONLY if the email doesn't exist yet; it gets
# instance-admin rights (Settings → Instance (Admin)). Without this, the first
# account to register becomes the instance admin instead. Changing
# ADMIN_PASSWORD later does NOT change the stored password — manage it in the
# app. See docs/ENTERPRISE_AUTH.md.
# ADMIN_EMAIL=ops@yourcompany.com
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME="Platform Ops"

# ---------------------------------------------------------------------------
# Optional — notifications
# ---------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=traceiq@yourcompany.com
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Data protection
# ---------------------------------------------------------------------------
# Ceiling on what any project may capture. No project setting can exceed it,
# and it is enforced when a run is dispatched — not in the worker — so a
# crafted job cannot get past it either.
#
#   none      pass/fail and timing only
#   minimal   + a masked failure screenshot
#   standard  + masked screenshots, scrubbed console and network logs
#   full      + video, Playwright trace and HAR
#
# Video, traces and HAR sit above `standard` because none of them can be
# meaningfully redacted — a trace is a full DOM-snapshot recording and a video
# records whatever was on screen. If this instance goes anywhere near personal
# data you are accountable for, set this to minimal or none: it is a property
# an auditor can verify once here instead of per project forever.
MAX_CAPTURE_LEVEL=standard

# Encryption key for secrets at rest (project secrets, MFA seeds, provider API
# keys, stored browser sessions). Separate from SECRET_KEY so you can rotate
# JWT signing without re-encrypting every stored secret at the same moment.
# Unset falls back to SECRET_KEY, which is what pre-0.3 instances did.
#   openssl rand -hex 32
# SECRETS_KEY=
# During a key rotation, put the OLD key here, restart, run
# `python scripts/rotate_secrets.py`, then clear this and restart again.
# SECRETS_KEY_PREVIOUS=

# TLS and at-rest encryption for the object store. MINIO_USE_SSL only picks the
# scheme for a scheme-less endpoint; an endpoint that spells out https:// wins.
# MINIO_SSE_ALGORITHM is AES256 or aws:kms; blank disables it.
MINIO_USE_SSL=false
# MINIO_SSE_ALGORITHM=AES256
# MINIO_SSE_KMS_KEY_ID=

# Promote the transport/at-rest findings from startup warnings to a refusal to
# boot. Off by default so upgrading cannot brick a running instance. Turn it on
# once Postgres has ?sslmode=require, Redis is rediss://, and the object store
# is https — then it is the switch to point an auditor at.
REQUIRE_TRANSPORT_SECURITY=false

# Bearer token for Prometheus to scrape GET /metrics. Leave unset and /metrics
# requires a logged-in user instead; it is never anonymous.
# METRICS_TOKEN=

# Audit-log retention, deliberately separate from RUN_RETENTION_DAYS: PCI DSS
# Req 10 wants a year of audit history regardless of how long you keep test
# artifacts, so tying them together would mean trimming disk silently trims
# compliance. 0 keeps audit history forever, which is the safe default for a
# record whose deletion is irreversible.
AUDIT_RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# Advanced — leave alone unless you know you need them
# ---------------------------------------------------------------------------
# Retries a failing step with an LLM-suggested selector. Needs an LLM provider.
RUNTIME_HEAL_ENABLED=false

# Runs user-uploaded Playwright specs verbatim. This is arbitrary code execution
# inside the worker container. Only enable on an instance where you trust every
# user, and never on one exposed to the internet.
RAW_PLAYWRIGHT_ENABLED=false
