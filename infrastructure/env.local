# General
OPENAI_API_KEY=your-key-here

# Backend
# Use a secure secret key for production!
SECRET_KEY=local-dev-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 
BACKEND_CORS_ORIGINS=["*"]

# Frontend
# Points to localhost for local development
VITE_API_BASE_URL=http://localhost:8000/api

# Execution Engine
ARTIFACTS_DIR=/tmp/artifacts
DEFAULT_TIMEOUT=30000

# Infrastructure (Postgres/MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
POSTGRES_USER=user
POSTGRES_PASSWORD=password
MINIO_PUBLIC_URL=http://localhost:9000

# Notification Settings
# Master switch - if false, no notifications sent
NOTIFICATIONS_ENABLED=false
# Individual channel controls (only used if NOTIFICATIONS_ENABLED=true)
EMAIL_NOTIFICATIONS_ENABLED=false
SLACK_NOTIFICATIONS_ENABLED=false
TEAMS_NOTIFICATIONS_ENABLED=false
# Only notify on failures (skip passed runs)
NOTIFY_ON_FAILURE_ONLY=true

# Email (SMTP) Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@traceiq.io

# Slack Webhook URL
SLACK_WEBHOOK_URL=

# Microsoft Teams Webhook URL
TEAMS_WEBHOOK_URL=

STALE_RUN_INACTIVITY_MINUTES=20   # allow 20min of inactivity before declaring stuck
MAX_RUN_DURATION_HOURS=8          # allow runs up to 8 hours

