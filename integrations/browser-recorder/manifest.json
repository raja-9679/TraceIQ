{
  "manifest_version": 3,
  "name": "TraceIQ Recorder",
  "version": "0.1.0",
  "description": "Record user journeys in any SaaS app and push them as TraceIQ test cases.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TraceIQ Recorder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
